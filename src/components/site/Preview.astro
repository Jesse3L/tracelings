---
// Static, indexable preview image of a worksheet (generated by `npm run previews`).
import previews from '../../data/previews.json';
interface Props { k: string; caption?: string }
const p = (previews as Record<string, { src: string; width: number; height: number; alt: string }>)[Astro.props.k];
---
{p && (
  <figure class="mt-10 max-w-[340px]">
    <img src={p.src} width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" class="block w-full h-auto rounded-lg border border-hairline bg-white shadow-[0_10px_30px_-18px_rgba(30,42,68,.35)]" />
    <figcaption class="mt-2 text-[14px] text-muted">{Astro.props.caption ?? 'Example of the free printable worksheet.'}</figcaption>
  </figure>
)}
