---
import '../styles/global.css';
import { SITE } from '../config';
import LogoMark from '../components/site/LogoMark.astro';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
}
import { fitDescription } from '../lib/seo';
const { title, schema, noindex = false } = Astro.props;
const description = fitDescription(Astro.props.description);
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(Astro.props.ogImage ?? '/og-default.png', SITE.url).href;
const menus = [
  {
    id: 'worksheets', label: 'Worksheets',
    items: [
      { href: '/name-tracing/', label: 'Name tracing', sub: 'Any name, dotted letters' },
      { href: '/letter-tracing/', label: 'Letter tracing', sub: 'A to Z, capital and lowercase' },
      { href: '/number-tracing/', label: 'Number tracing', sub: '0 to 20, plus 1-10 and 1-20 sheets' },
      { href: '/sight-words/', label: 'Sight words', sub: 'Dolch lists and flash cards' },
      { href: '/cursive/', label: 'Cursive worksheets', sub: 'Any word or sentence' },
      { href: '/cursive-name-tracing/', label: 'Cursive name tracing', sub: 'Their name in cursive' },
      { href: '/cursive-alphabet/', label: 'Cursive alphabet', sub: 'Every letter, A to Z' },
      { href: '/alphabet-chart/', label: 'Alphabet charts', sub: 'Print and cursive' },
    ],
  },
  {
    id: 'coloring', label: 'Coloring',
    items: [
      { href: '/coloring-pages/', label: 'Coloring pages', sub: 'Dinosaurs, holidays and more' },
      { href: '/name-coloring-pages/', label: 'Name coloring pages', sub: 'Their name to color' },
      { href: '/bubble-letters/', label: 'Bubble letters', sub: 'A to Z and a generator' },
      { href: '/coloring-pages/thanksgiving-coloring-pages/', label: 'Thanksgiving coloring', sub: 'Turkeys, pies and leaves', badge: 'In season' },
      { href: '/coloring-pages/christmas-coloring-pages/', label: 'Christmas coloring', sub: 'Trees, gifts and Santa' },
    ],
  },
];
const path = Astro.url.pathname;
const isOn = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const footerCols = [
  { title: 'Worksheets', links: menus[0].items.map(({ href, label }) => ({ href, label })) },
  { title: 'Coloring', links: [...menus[1].items.slice(0, 3).map(({ href, label }) => ({ href, label })), { href: '/coloring-pages/thanksgiving-coloring-pages/', label: 'Thanksgiving coloring pages' }, { href: '/coloring-pages/dinosaur-coloring-pages/', label: 'Dinosaur coloring pages' }] },
  { title: 'Tracelings', links: [
    { href: '/learn/', label: 'Learn: guides for parents' },
    { href: '/membership/', label: 'Membership' },
    { href: '/class-pack/', label: 'Class pack' },
    { href: '/account/', label: 'Member sign in' },
    { href: '/about/', label: 'About' },
    { href: `mailto:${SITE.email}`, label: 'Contact' },
  ] },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f8fb" />
    <meta property="og:type" content={Astro.props.ogType ?? 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white px-3 py-2 rounded">Skip to content</a>
    <header class="site-header sticky top-0 z-40 border-b border-hairline bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/75">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 h-16 flex items-center gap-6">
        <a href="/" class="flex items-center gap-2.5 shrink-0 rounded-lg" aria-label={`${SITE.name} home`}>
          <LogoMark size={34} />
          <span class="text-[1.4rem] font-bold tracking-tight text-ink leading-none">{SITE.name}</span>
        </a>

        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex items-center gap-1 text-[15px]">
            {menus.map((m) => (
              <li class="relative" data-dd>
                <button type="button" class={`nav-link inline-flex items-center gap-1 ${m.items.some((i) => isOn(i.href)) ? 'is-on' : ''}`} aria-expanded="false" aria-controls={`dd-${m.id}`}>
                  {m.label}
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="dd-caret transition-transform"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div id={`dd-${m.id}`} class="dd-panel" hidden>
                  <ul class={`grid gap-1 ${m.items.length > 5 ? 'grid-cols-2 w-[520px]' : 'w-[300px]'}`}>
                    {m.items.map((i) => (
                      <li>
                        <a href={i.href} class="dd-item" aria-current={isOn(i.href) ? 'page' : undefined}>
                          <span class="flex items-center gap-2 font-bold text-ink">{i.label}{i.badge && <span class="rounded-full bg-[#fff4d6] px-2 py-0.5 text-[11px] font-bold text-[#7a5a00]">{i.badge}</span>}</span>
                          <span class="block text-[13px] text-muted">{i.sub}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
            <li><a href="/class-pack/" class={`nav-link ${isOn('/class-pack/') ? 'is-on' : ''}`}>Class pack</a></li>
            <li><a href="/learn/" class={`nav-link ${isOn('/learn/') ? 'is-on' : ''}`}>Learn</a></li>
          </ul>
        </nav>

        <div class="ml-auto flex items-center gap-2">
          <a href="/account/" class="hidden sm:inline-flex nav-link">Sign in</a>
          <a href="/membership/" class="btn-pencil hidden sm:inline-flex px-4 py-2 text-[15px]">Membership</a>
          <button type="button" class="lg:hidden inline-flex items-center justify-center size-11 rounded-lg text-ink hover:bg-[#eef2f8]" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
            <span class="sr-only">Menu</span>
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" class="menu-open"><path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" class="menu-close hidden"><path d="M5 5l12 12M17 5 5 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="lg:hidden border-t border-hairline bg-white max-h-[calc(100dvh-4rem)] overflow-y-auto" hidden>
        <div class="mx-auto max-w-6xl px-4 sm:px-6 py-4 grid gap-5 sm:grid-cols-2">
          {menus.map((m) => (
            <div>
              <p class="text-[12px] font-bold uppercase tracking-wider text-muted mb-1">{m.label}</p>
              <ul>
                {m.items.map((i) => (
                  <li><a href={i.href} class="flex items-center gap-2 py-2.5 text-[16px] text-ink border-b border-hairline/70" aria-current={isOn(i.href) ? 'page' : undefined}>{i.label}{i.badge && <span class="rounded-full bg-[#fff4d6] px-2 py-0.5 text-[11px] font-bold text-[#7a5a00]">{i.badge}</span>}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div class="sm:col-span-2 grid grid-cols-2 gap-2 pt-1">
            <a href="/class-pack/" class="rounded-lg border border-hairline px-4 py-3 text-center font-bold text-ink">Class pack</a>
            <a href="/learn/" class="rounded-lg border border-hairline px-4 py-3 text-center font-bold text-ink">Learn</a>
            <a href="/account/" class="rounded-lg border border-hairline px-4 py-3 text-center font-bold text-ink">Sign in</a>
            <a href="/membership/" class="btn-pencil px-4 py-3 text-center">Membership</a>
          </div>
        </div>
      </div>
    </header>
    <main id="main" class="flex-1"><slot /></main>
    <footer class="site-footer mt-24 bg-ink text-[#c9d2e3]">
      <div class="footer-rule" aria-hidden="true"></div>
      <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-12 pb-8">
        <div class="grid gap-10 md:grid-cols-[minmax(0,1.3fr)_repeat(3,minmax(0,1fr))]">
          <div>
            <a href="/" class="inline-flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
              <LogoMark size={36} onDark />
              <span class="text-[1.4rem] font-bold tracking-tight text-white leading-none">{SITE.name}</span>
            </a>
            <p class="mt-4 max-w-xs text-[15px] leading-relaxed">Free printable worksheets made with your child's name, for parents, teachers and homeschool families.</p>
            <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/8 px-3 py-1.5 text-[13px] text-white">
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1.5 2.5 3.3v3.4c0 2.7 1.9 4.9 4.5 5.8 2.6-.9 4.5-3.1 4.5-5.8V3.3L7 1.5Z" fill="none" stroke="#3fbf85" stroke-width="1.5" stroke-linejoin="round"/><path d="m4.9 7 1.5 1.5 2.8-3" fill="none" stroke="#3fbf85" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Names you type never leave your device
            </p>
          </div>
          {footerCols.map((c) => (
            <nav aria-label={c.title}>
              <p class="text-[13px] font-bold uppercase tracking-wider text-white">{c.title}</p>
              <ul class="mt-3 space-y-2 text-[15px]">
                {c.links.map((l) => <li><a href={l.href} class="hover:text-white hover:underline underline-offset-4">{l.label}</a></li>)}
              </ul>
            </nav>
          ))}
        </div>
        <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-[13px] sm:flex-row sm:items-center sm:justify-between">
          <p>&copy; {year} {SITE.name}, a Veridian Ventures LLC company. Free for personal and classroom use.</p>
          <ul class="flex gap-5">
            <li><a href="/privacy/" class="hover:text-white">Privacy</a></li>
            <li><a href="/terms/" class="hover:text-white">Terms</a></li>
            <li><a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a></li>
          </ul>
        </div>
      </div>
    </footer>
    <script>
      // Header dropdowns (click, keyboard, hover on mouse devices) and the mobile menu.
      const dds = [...document.querySelectorAll<HTMLElement>('[data-dd]')];
      const setDd = (dd: HTMLElement, open: boolean) => {
        const btn = dd.querySelector('button')!; const panel = dd.querySelector<HTMLElement>('.dd-panel')!;
        btn.setAttribute('aria-expanded', String(open)); panel.hidden = !open;
      };
      const closeAll = (except?: HTMLElement) => dds.forEach((d) => d !== except && setDd(d, false));
      const hover = matchMedia('(hover: hover) and (pointer: fine)').matches;
      dds.forEach((dd) => {
        const btn = dd.querySelector('button')!;
        btn.addEventListener('click', () => { const open = btn.getAttribute('aria-expanded') !== 'true'; closeAll(dd); setDd(dd, open); });
        if (hover) {
          let t: number | undefined;
          dd.addEventListener('mouseenter', () => { clearTimeout(t); closeAll(dd); setDd(dd, true); });
          dd.addEventListener('mouseleave', () => { t = window.setTimeout(() => setDd(dd, false), 160); });
        }
        dd.addEventListener('focusout', (e) => { if (!dd.contains(e.relatedTarget as Node)) setDd(dd, false); });
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { const open = dds.find((d) => d.querySelector('button')!.getAttribute('aria-expanded') === 'true'); closeAll(); open?.querySelector('button')!.focus(); } });
      document.addEventListener('click', (e) => { if (!(e.target as Element).closest('[data-dd]')) closeAll(); });
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open)); if (menu) menu.hidden = !open;
        toggle.querySelector('.menu-open')!.classList.toggle('hidden', open);
        toggle.querySelector('.menu-close')!.classList.toggle('hidden', !open);
      });
    </script>
  </body>
</html>
