---
import { faqText } from '../../../lib/seo';
import Preview from '../../../components/site/Preview.astro';
import Base from '../../../layouts/Base.astro';
import MathSheets from '../../../components/MathSheets.tsx';
import Faqs from '../../../components/homeschool/Faqs.astro';
import { SITE } from '../../../config';

const url = new URL('/math-worksheets/kindergarten-addition/', SITE.url).href;
const title = `Free Kindergarten Addition Worksheets | ${SITE.name}`;
const description = 'Free kindergarten addition worksheets within 5, 10 and 20: picture addition, number line addition, addition facts, plus subtraction with pictures.';

const faqs = [
  { q: 'What addition should a kindergartner know?', a: 'Many kindergarten programs work on adding and taking away within 10 using objects, pictures and fingers, and on knowing the facts within 5 quickly by the end of the year. Adding within 20 is usually a first grade goal. Kids develop at different speeds. If you have concerns, ask your child’s teacher or pediatrician.' },
  { q: 'Which addition worksheet should we start with?', a: 'Start with picture addition within 5, so your child can count every picture. Then try within 10. Number line addition comes next, once your child can count on from a number. Addition facts with no pictures work best after a few weeks of the picture pages.' },
  { q: 'Is it okay to count on fingers?', a: 'Yes. Fingers are a counting tool that every child carries around. Over time, many kids start to remember facts like 2 + 3 and stop needing them. Counting on from the bigger number (start at 6, then 7, 8) is a good next step.' },
  { q: 'Is there a kindergarten subtraction worksheet too?', a: 'Yes. Pick Subtraction with pictures in the maker. Some pictures have an X to show they were taken away, and your child counts what is left. For more, the kindergarten subtraction worksheets page adds cross out and subtract, number line subtraction and subtraction facts, in the same ranges: within 5, 10 and 20.', html: 'Yes. Pick Subtraction with pictures in the maker. Some pictures have an X to show they were taken away, and your child counts what is left. For more, the <a href="/math-worksheets/kindergarten-subtraction/">kindergarten subtraction worksheets</a> page adds cross out and subtract, number line subtraction and subtraction facts, in the same ranges: within 5, 10 and 20.' },
  { q: 'Are these kindergarten addition worksheets free?', a: 'Yes. Every page type, every range and the New problems button are free, one page at a time. Members can also print five different pages in one PDF, or one page for every child on their list, with no footer line.', html: 'Yes. Every page type, every range and the New problems button are free, one page at a time. <a href="/membership/">Members</a> can also print five different pages in one PDF, or one page for every child on their list, with no footer line.' },
  { q: 'Do these fit the kindergarten plan?', a: 'Yes. From week 22, the kindergarten homeschool plan moves from ten frames to adding within 5 and then within 10 with dot pictures. These pages give extra practice at the same level.', html: 'Yes. From week 22, the <a href="/homeschool/kindergarten/">kindergarten homeschool curriculum</a> moves from ten frames to adding within 5 and then within 10 with dot pictures. These pages give extra practice at the same level.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: 'Kindergarten addition worksheets (free generator)',
    url,
    learningResourceType: 'Worksheet',
    educationalLevel: 'Kindergarten',
    teaches: 'Addition within 5, 10 and 20 with pictures and a number line, addition facts, subtraction with pictures',
    isAccessibleForFree: true,
    inLanguage: 'en-US',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Kindergarten math worksheets', item: SITE.url + '/math-worksheets/kindergarten/' },
      { '@type': 'ListItem', position: 3, name: 'Kindergarten addition worksheets', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: faqText(f) } })),
  },
];
---
<Base title={title} description={description} schema={schema}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <nav aria-label="Breadcrumb" class="pt-6 text-[14px] text-muted">
      <a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span> <a href="/math-worksheets/kindergarten/" class="hover:text-ink">Kindergarten math</a> <span aria-hidden="true">/</span> <span aria-current="page">Addition</span>
    </nav>
    <header class="pt-6 pb-8 max-w-3xl">
      <h1 class="text-[2.1rem] sm:text-[2.8rem] font-bold"><span class="ruled">Kindergarten addition worksheets</span></h1>
      <p class="mt-4 text-lg text-muted">This page makes free printable kindergarten addition worksheets within 5, 10 or 20: picture addition, number line addition and addition facts, plus subtraction with pictures. Pick a page, tap New problems for a fresh set, and print as many as you need.</p>
    </header>

    <div id="maker" class="scroll-mt-24">
      <MathSheets client:load source="kindergarten-addition" series="k-addition" />
    </div>
    <Preview k="k-addition" caption="Example: picture addition within 10." />

    <article class="prose-tl max-w-[68ch] mt-14">
      <p class="text-[1.15rem]!">
        Kindergarten addition starts with things you can count: three apples and two more apples. These worksheets follow that path, from
        pictures to a number line to plain number sentences, so your child always has a way to find the answer. Every page is made in your
        browser with fresh problems, and the child's name on the page never leaves your device.
      </p>

      <h2>Four kinds of addition and subtraction pages</h2>
      <ul>
        <li><strong>Picture addition:</strong> two boxes of pictures with a plus sign between them. Count each group, then count them all and write the total.</li>
        <li><strong>Number line addition:</strong> a number line under each problem with a dot on the first number. Hop forward the second number and write where you land.</li>
        <li><strong>Addition facts:</strong> twelve number sentences, no pictures. Good for practice once the picture pages feel easy.</li>
        <li><strong>Subtraction with pictures:</strong> a group of pictures with some crossed out. Count what is left and write it in the box.</li>
      </ul>

      <h2>Within 5, within 10 or within 20?</h2>
      <p>
        <strong>Within 5</strong> means no answer is bigger than 5. It is the right start for most kids, because every problem fits on one
        hand. Move to <strong>within 10</strong> when your child can add within 5 without counting every picture twice. <strong>Within 20</strong> is
        a stretch for kindergarten: the sums run from 8 to 20 and each part stays at 10 or below, so it is a gentle bridge to first grade.
      </p>
      <p>
        Many kids add within 10 with pictures or fingers somewhere between ages 5 and 6, and adding without pictures often comes later.
        Kids develop at different speeds. If you have concerns, ask your child's teacher or pediatrician.
      </p>

      <h2>Picture addition worksheets for kindergarten</h2>
      <p>
        Pictures sit in rows of five, so kids start to see 5 without counting. Let your child touch each picture as they count, or cover
        each one with a small cracker. When they count the total, encourage them to start from the first group's number and count on:
        "four... five, six, seven." Counting on is one of the big steps in kindergarten addition.
      </p>

      <h2>Number line addition</h2>
      <p>
        The number line is a picture of counting on. Put a finger on the blue dot, then hop one space at a time while saying the numbers.
        Drawing little arcs for each hop helps kids keep track. The within 20 page has a longer tick at every 5 and 10, which makes the
        bigger numbers easier to find.
      </p>

      <h2>Kindergarten subtraction worksheets</h2>
      <p>
        Subtraction is the same idea in reverse. The crossed-out pictures show what was taken away, and your child counts what is left.
        Act it out first: line up six toy cars, drive two away, and ask how many are still parked. Then do the page. For cross out and
        subtract, number line subtraction and subtraction facts, see the <a href="/math-worksheets/kindergarten-subtraction/">kindergarten subtraction worksheets</a>.
        When both feel easy, the <a href="/math-worksheets/kindergarten-addition-and-subtraction/">mixed addition and subtraction worksheets</a> put
        plus and minus problems on the same page, so your child has to read the sign. To practice the same adding as little stories,
        try the <a href="/math-worksheets/kindergarten-word-problems/">kindergarten word problems</a>.
      </p>

      <h2>More kindergarten math</h2>
      <p>
        For the make 10 facts and adding with two colors of dots, see the <a href="/math-worksheets/ten-frames/">ten frame addition worksheets</a>.
        Before adding, many kids need practice comparing amounts, which is on the <a href="/math-worksheets/more-or-less/">more or less worksheets</a> page.
        Every math maker is listed on our <a href="/math-worksheets/kindergarten/">kindergarten math worksheets</a> page, with a free sampler to print.
      </p>

      <h2>A 10-minute addition routine</h2>
      <ol>
        <li><strong>3 minutes:</strong> act out two problems with toys or snacks. Say each one as a sentence: "three bears and two more bears is five bears."</li>
        <li><strong>5 minutes:</strong> one worksheet side by side. Do the first problem together, then let your child do the next two alone.</li>
        <li><strong>2 minutes:</strong> a finger game. Hold up some fingers on each hand and ask how many in all.</li>
      </ol>
    </article>

    <section class="prose-tl max-w-[68ch] mt-14" aria-labelledby="faq-h">
      <h2 id="faq-h">Questions about kindergarten addition</h2>
      <Faqs faqs={faqs} />
    </section>
  </div>
</Base>
