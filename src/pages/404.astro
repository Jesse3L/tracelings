---
import Base from '../layouts/Base.astro';
const links = [
  { href: '/name-tracing/', label: 'Name tracing worksheets' },
  { href: '/letter-tracing/', label: 'Letter tracing A to Z' },
  { href: '/coloring-pages/', label: 'Coloring pages' },
  { href: '/sight-words/', label: 'Sight words' },
  { href: '/cursive/', label: 'Cursive worksheets' },
];
---
<Base title="Page not found | Tracelings" description="That page doesn't exist. Try one of our free printable worksheets instead." noindex>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 pt-16">
    <h1 class="text-[2.2rem] sm:text-[2.8rem] font-bold"><span class="ruled">This page isn't here</span></h1>
    <p class="mt-6 text-lg text-muted">The link may be old or mistyped. These are the most popular printables:</p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {links.map((l) => <li><a href={l.href} class="block rounded-lg border border-hairline bg-white px-4 py-3 font-bold text-ink hover:border-rule">{l.label}</a></li>)}
    </ul>
    <p class="mt-8"><a href="/" class="text-[#2f5fc4] underline underline-offset-4">Go to the homepage</a></p>
  </div>
</Base>
