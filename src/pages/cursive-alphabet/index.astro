---
import Base from '../../layouts/Base.astro';
import FontTool from '../../components/FontTool.tsx';
import { SITE } from '../../config';

const title = `Cursive Alphabet Worksheets (Free Printable) | ${SITE.name}`;
const description = 'Free cursive alphabet worksheets with capital and lowercase letters on guide lines. Trace each letter, then write it. Prints on Letter or A4.';
const url = new URL('/cursive-alphabet/', SITE.url).href;
const sets = [
  { label: 'A to G', text: 'Aa Bb Cc Dd Ee Ff Gg' },
  { label: 'H to N', text: 'Hh Ii Jj Kk Ll Mm Nn' },
  { label: 'O to U', text: 'Oo Pp Qq Rr Ss Tt Uu' },
  { label: 'V to Z', text: 'Vv Ww Xx Yy Zz' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'LearningResource', name: 'Cursive alphabet worksheets', url, learningResourceType: 'Worksheet', educationalLevel: 'Grades 2-4', isAccessibleForFree: true, description },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Cursive Worksheets', item: SITE.url + '/cursive/' },
    { '@type': 'ListItem', position: 3, name: 'Cursive Alphabet', item: url },
  ] },
];
---
<Base title={title} description={description} schema={schema}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <nav aria-label="Breadcrumb" class="pt-6 text-[14px] text-muted">
      <a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span>
      <a href="/cursive/" class="hover:text-ink">Cursive</a> <span aria-hidden="true">/</span>
      <span aria-current="page">Cursive alphabet</span>
    </nav>
    <header class="pt-6 pb-8 max-w-3xl">
      <h1 class="text-[2.1rem] sm:text-[2.8rem] font-bold"><span class="ruled">Cursive alphabet worksheets</span></h1>
      <p class="mt-4 text-lg text-muted">Capital and lowercase cursive letters, a few at a time. Edit the letters in the box to make your own set.</p>
    </header>

    <FontTool client:load kind="cursive" preset="Aa Bb Cc Dd Ee Ff Gg" source="cursive" />

    <article class="prose-tl max-w-[68ch] mt-12">
      <p class="text-[1.15rem]!">
        These free cursive alphabet worksheets show each capital and lowercase letter on handwriting lines, with gray letters to trace and
        blank rows to practice. Work through the alphabet in four sets so each sheet stays short enough to finish in one sitting.
      </p>
      <h2>The four alphabet sets</h2>
      <p>Copy one of these into the box above to print the next set:</p>
      <ul>{sets.map((s) => <li><strong>{s.label}:</strong> {s.text}</li>)}</ul>
      <h2>Which letters to teach first</h2>
      <p>
        Alphabetical order works, but many teachers start with lowercase letters that share a stroke. The c-shape family (a, c, d, g, o, q)
        and the loop letters (b, e, f, h, k, l) each build on one motion, so learning them together goes faster. Capitals usually come last,
        since kids use them less often.
      </p>
      <h2>Practice that sticks</h2>
      <ul>
        <li>Five minutes a day is plenty. One set per week is a good pace.</li>
        <li>Say each letter's motion out loud while tracing, like "up, loop, down."</li>
        <li>Slip a sheet into a page protector and practice it again with a dry-erase marker.</li>
      </ul>
      <p>Ready for whole words? Use the <a href="/cursive/">cursive worksheet generator</a> to practice their name in cursive.</p>
    </article>
  </div>
</Base>
