---
import Base from '../../layouts/Base.astro';
import Seo2CursiveAlphabet from '../../components/seo/Seo2CursiveAlphabet.tsx';
import Seo2ChartButton from '../../components/seo/Seo2ChartButton.tsx';
import { SITE } from '../../config';
import letters from '../../data/cursive-letters.json';

const title = `Cursive Alphabet Worksheets (Free Printable) | ${SITE.name}`;
const description = 'Free cursive alphabet worksheets and practice sheets for capital and lowercase letters A to Z. Trace each letter, then write it. Free printable PDF.';
const url = new URL('/cursive-alphabet/', SITE.url).href;
const chartAlt = 'Cursive alphabet chart showing capital and lowercase cursive letters A to Z';

const faqs = [
  { q: 'Which cursive letters should kids learn first?', a: 'Most teachers start with lowercase letters that share a stroke rather than going in ABC order. Easy upstroke letters like i, t, u and w come first, then the round letters a, c, d, g, o and q, then the loop letters e, l, h, k, b and f, and finally the hump letters n, m, v, x, y and z. Capitals usually come after the lowercase letters, since kids write them less often.' },
  { q: 'How long does it take to learn the cursive alphabet?', a: 'It varies a lot. With five to ten minutes of practice most days, many kids can form every lowercase letter within a few weeks and the capitals within a couple of months. Writing whole words smoothly takes longer, often most of a school year. Adults relearning cursive are often comfortable within two to four weeks.' },
  { q: 'Are these cursive alphabet worksheets free?', a: 'Yes. Your first PDF downloads right away. After that we ask for your email once, and every sheet stays free on that device for home and classroom use.' },
  { q: 'What style of cursive is this?', a: 'A traditional looped cursive close to what most US schools teach, drawn from an open-licensed handwriting font made for teaching. A few capitals, such as Q, Z, F and S, differ between handwriting programs. If your child’s school uses another form, follow the school.' },
  { q: 'Is there a cursive alphabet chart I can print?', a: 'Yes. The chart on this page shows every capital and lowercase cursive letter from A to Z on handwriting lines. Use the download button under it to get a PDF for the wall or a homework folder.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: 'Cursive alphabet worksheets and chart',
    url,
    learningResourceType: ['Worksheet', 'Chart'],
    educationalLevel: 'Grades 2-4',
    teaches: 'Writing capital and lowercase cursive letters A to Z',
    isAccessibleForFree: true,
    inLanguage: 'en-US',
    image: SITE.url + '/cursive-alphabet/cursive-alphabet-chart.svg',
    description,
    hasPart: letters.map((l) => ({ '@type': 'LearningResource', name: `Cursive ${l.letter.toUpperCase()}`, url: `${SITE.url}/cursive-alphabet/${l.letter}/` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Cursive Worksheets', item: SITE.url + '/cursive/' },
      { '@type': 'ListItem', position: 3, name: 'Cursive Alphabet', item: url },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={title} description={description} schema={schema}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <nav aria-label="Breadcrumb" class="pt-6 text-[14px] text-muted">
      <a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span> <a href="/cursive/" class="hover:text-ink">Cursive</a> <span aria-hidden="true">/</span> <span aria-current="page">Cursive alphabet</span>
    </nav>
    <header class="pt-6 pb-8 max-w-3xl">
      <h1 class="text-[2.1rem] sm:text-[2.8rem] font-bold"><span class="ruled">Free cursive alphabet worksheets and practice sheets</span></h1>
      <p class="mt-4 text-lg text-muted">Capital and lowercase cursive letters, a few at a time. Pick a set, or print the whole alphabet in one PDF.</p>
    </header>

    <Seo2CursiveAlphabet client:load source="cursive-alphabet" />


    <article class="prose-tl max-w-[68ch] mt-12">
      <p class="text-[1.15rem]!">
        These free cursive alphabet worksheets show each capital and lowercase letter on handwriting lines, with a solid example, gray
        letters to trace and blank rows to practice. The alphabet is split into four short sets so each sheet can be finished in one
        sitting, or you can print all four as one cursive alphabet practice packet.
      </p>
    </article>

    <section class="mt-12" aria-labelledby="chart">
      <h2 id="chart" class="text-[1.6rem] font-bold">Cursive alphabet chart</h2>
      <p class="mt-2 mb-5 text-muted max-w-[68ch]">Every capital and lowercase cursive letter from A to Z on one page. Keep it on the desk or tape it inside a homework folder while your child practices.</p>
      <figure class="max-w-2xl">
        <img src="/cursive-alphabet/cursive-alphabet-chart.svg" width="612" height="792" alt={chartAlt} loading="lazy" decoding="async" class="sheet-frame w-full h-auto bg-white" />
        <figcaption class="sr-only">{chartAlt}</figcaption>
      </figure>
      <div class="mt-5">
        <Seo2ChartButton client:visible source="cursive-alphabet-chart" />
      </div>
      <p class="mt-3 text-[15px] text-muted">Want a print chart too? Make one on the <a class="text-[#2f5fc4] underline underline-offset-2" href="/alphabet-chart/">printable alphabet chart</a> page.</p>
    </section>

    <section class="mt-14" aria-labelledby="letters">
      <h2 id="letters" class="text-[1.6rem] font-bold">Practice one cursive letter at a time</h2>
      <p class="mt-2 text-muted max-w-[68ch]">Each letter has its own page with stroke-by-stroke steps for the capital and lowercase, common mistakes and a worksheet.</p>
      <ul class="mt-5 grid grid-cols-4 sm:grid-cols-7 lg:grid-cols-13 gap-2 max-w-4xl">
        {letters.map((l) => (
          <li>
            <a href={`/cursive-alphabet/${l.letter}/`} class="block rounded-lg border border-hairline bg-white py-2.5 text-center hover:border-rule">
              <img src={`/cursive-alphabet/cursive-${l.letter}.svg`} alt="" loading="lazy" decoding="async" class="mx-auto h-10 w-auto" />
              <span class="block text-[14px] font-bold text-ink">Cursive {l.letter.toUpperCase()}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <article class="prose-tl max-w-[68ch] mt-12">
      <h2>Which cursive letters to teach first</h2>
      <p>
        Alphabetical order works, but many teachers group lowercase letters by their first stroke. Upstroke letters (i, t, u, w) are the
        easiest. Round letters (a, c, d, g, o, q) all begin with the same curve. Loop letters (e, l, h, k, b, f) swing up into a loop, and
        hump letters (n, m, v, x, y, z) start with a small hill. Learning a whole group together goes faster than learning letters one by
        one. Capitals usually come last.
      </p>
      <h2>Practice that sticks</h2>
      <ul>
        <li>Five to ten minutes most days is plenty. One set per week is a comfortable pace.</li>
        <li>Say each letter's motion out loud while tracing, like "up, loop, down."</li>
        <li>Slip a sheet into a page protector and practice again with a dry-erase marker.</li>
        <li>Watch b, o, v and w. They end at the midline, so the next letter joins across the top.</li>
      </ul>

      <h2>Frequently asked questions</h2>
      <div class="divide-y divide-hairline border-y border-hairline">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none flex justify-between gap-4 font-bold text-[1.075rem] text-ink">{f.q}<span aria-hidden="true" class="text-muted group-open:rotate-45 transition-transform">+</span></summary>
            <p class="mt-3 mb-0!">{f.a}</p>
          </details>
        ))}
      </div>

      <h2>Ready for words?</h2>
      <p>
        Turn any word or sentence into a sheet with the <a href="/cursive/">cursive worksheet generator</a>, or make a <a href="/cursive-name-tracing/">cursive name tracing worksheet</a> so your child can practice the word they care about most.
      </p>
    </article>
  </div>
</Base>
