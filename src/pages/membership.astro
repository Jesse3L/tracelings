---
import Base from '../layouts/Base.astro';
import MembershipCheckout from '../components/MembershipCheckout.tsx';
import { SITE } from '../config';

const rows = [
  ['Price', '$0', '$5.99/month or $39/year', '$79/year'],
  ['Tracing sheets for any name', 'Yes', 'Yes', 'Yes'],
  ['Letters, numbers, cursive, sight words, coloring pages', 'Yes', 'Yes', 'Yes'],
  ['Saved class list for every name tool', 'No', 'Up to 8 kids', 'Up to 40 names'],
  ['Class pack: tracing, cursive and coloring for each child in one PDF', 'No', 'Yes', 'Yes'],
  ['Footer line on printables', 'Small credit line', 'None', 'None'],
  ['Email prompt on downloads', 'Once', 'Never', 'Never'],
  ['New member features as they launch', 'No', 'Included', 'Included'],
];
const coming = [
  'Seasonal and holiday name tracing themes',
  'Turn a photo into a coloring page',
  'A weekly themed printable pack by email',
];
const faqs = [
  { q: 'What do I get today?', a: 'Every printable with no footer line and no email prompts. Save your class list once and it works in name tracing, cursive and name coloring pages, or print a class pack with all three for every child in one PDF. Family covers up to 8 kids; Classroom and Founding cover up to 40 names. New member features are added at no extra cost.' },
  { q: 'What is the founding member price?', a: 'The first 200 members pay $29 a year and keep that price for as long as they stay members. It includes everything in the Classroom plan.' },
  { q: 'Can I cancel anytime?', a: 'Yes. Cancel from your account page in a couple of clicks, with no phone call. You keep membership until the end of the period you paid for and you won’t be charged again. Not happy in the first 14 days? Email us for a full refund.' },
  { q: 'How do I sign in on another device?', a: 'Go to Member sign in and enter the email you used at checkout plus the last 4 digits of the card you paid with. There’s no password to remember.' },
  { q: 'Does the free version stay free?', a: 'Yes. Single tracing sheets for any name, plus letters, numbers, cursive, sight words and coloring pages, stay free. Nothing that’s free today is moving behind the paywall.' },
  { q: 'Who handles payment?', a: 'Square, the same payment company many local shops use. Your card details go straight to Square and never touch our servers.' },
  { q: 'Is my child’s information private?', a: 'Yes. Worksheets are built in your browser, so the names you type stay on your device, members included. We only keep your email for billing and sign-in.' },
  { q: 'Do you offer school pricing?', a: `The Classroom plan covers one teacher. For several teachers or a whole school, email ${SITE.email} and we’ll put together a quote.` },
];
---
<Base title={`${SITE.name} Membership for Families and Classrooms`} description="Print name tracing worksheets for a whole class in one PDF, with no footer line or email prompts. Family $39/year, Classroom $79/year, founding price $29/year.">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] items-start">
      <div class="prose-tl">
        <h1 class="text-[2.1rem] sm:text-[2.8rem] font-bold"><span class="ruled">Membership for families and classrooms</span></h1>
        <p class="mt-6">{SITE.name} is free, and it's staying that way. Type any name, print a tracing sheet, done.</p>
        <p>Membership is for the people printing a lot: the parent with three kids at the kitchen table, the homeschooler planning a whole week, the kindergarten teacher with 22 names to trace before the first day.</p>
        <p class="rounded-xl bg-[#fff4d6] p-4 text-ink!"><strong>Founding offer:</strong> the first 200 members get everything for $29/year, locked in for as long as they stay members.</p>
        <h2 class="text-[1.3rem]! mt-8!">Coming soon for members</h2>
        <ul>{coming.map((c) => <li>{c}</li>)}</ul>
        <p class="text-[15px]">These are included in every plan as they launch. No price change.</p>
      </div>
      <MembershipCheckout client:load />
    </div>

    <section class="mt-14" aria-labelledby="plans">
      <h2 id="plans" class="text-[1.6rem] font-bold">Plans at a glance</h2>
      <div class="mt-5 overflow-x-auto rounded-xl border border-hairline bg-white">
        <table class="w-full min-w-[620px] text-left text-[15px]">
          <thead>
            <tr class="border-b border-hairline">
              <th class="p-4 font-bold"><span class="sr-only">Feature</span></th>
              <th class="p-4 font-bold">Free</th>
              <th class="p-4 font-bold">Family</th>
              <th class="p-4 font-bold">Classroom</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-b border-hairline last:border-0">
                <th scope="row" class="p-4 font-normal text-ink">{r[0]}</th>
                <td class="p-4 text-muted">{r[1]}</td>
                <td class="p-4 text-muted">{r[2]}</td>
                <td class="p-4 text-muted">{r[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="prose-tl max-w-[68ch] mt-14" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      <div class="divide-y divide-hairline border-y border-hairline">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none flex justify-between gap-4 font-bold text-[1.075rem] text-ink">{f.q}<span aria-hidden="true" class="text-muted group-open:rotate-45 transition-transform">+</span></summary>
            <p class="mt-3 mb-0!">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>
