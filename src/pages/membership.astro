---
import Base from '../layouts/Base.astro';
import MembershipCheckout from '../components/MembershipCheckout.tsx';
import { SITE } from '../config';

const included = [
  { t: 'A plan built for your child', d: 'A short placement check sets the level (Pre-K or Kindergarten) and the starting week. Skills they already have get skipped. Shaky ones come back for review.' },
  { t: 'Weekly packs themed on what they love', d: 'Dinosaurs, trucks, unicorns, space and more. Counting pages, ten frames, adding, word families and letter pages use their favorite things.' },
  { t: 'A new story starring your child, every week', d: 'A little book at their reading level, made fresh each week with that week\'s letters, word family and sight words. Not quite right? Make a new story, up to 2 times a week.' },
  { t: 'Word problems and a parent note', d: '4 to 6 themed word problems at the week\'s math level, a tracing sentence, and a short note for you: what the week teaches, why, and 2 ideas to try away from the paper.' },
  { t: 'A 1-minute check-in that adjusts the plan', d: 'Tap "got it" or "still working" for each skill. The next weeks add an extra review week or move ahead.' },
  { t: 'A progress report to print', d: 'Skills practiced and where your child is now, handy for homeschool records.' },
  { t: 'Every kid in the family', d: 'Up to 4 child profiles, each with their own level, pace and interests, on one plan.' },
  { t: 'Batch printing, no footer line', d: 'Print every free tool for the whole family in one PDF, with no credit line and no email prompts.' },
];
const faqs = [
  { q: 'What does the program include?', a: 'A homeschool plan for each child at their level and pace, with weekly printable packs themed on their interests. Each week adds a new story starring your child, 4 to 6 word problems, a tracing sentence and a parent note. A 1-minute weekly check-in adjusts the plan, and you can print a progress report anytime. It covers up to 4 kids in one family.' },
  { q: 'Can I try it before I pay?', a: 'Yes. Week 1 of your child\'s own plan is free: take the placement check, and you can print the whole first week, themed and with your child\'s name. There is no free trial beyond that, so you see exactly what you get before you decide.' },
  { q: 'How much does it cost?', a: '$14.99 a month, or $99 a year (that works out to $8.25 a month). One price covers every kid in your family, up to 4.' },
  { q: 'Is my child\'s name private?', a: 'Yes. Your child\'s name stays on your device. We never send it to our servers or to the AI that writes the stories. The story is written with a blank where the name goes, and your browser fills it in when it makes the PDF. We only keep a profile with no name: age, skills, interests and pace.' },
  { q: 'Who writes the stories?', a: 'An AI writing tool, with strict rules: short and warm, at your child\'s reading level, nothing scary, and faith neutral (the faith track adds a Bible verse from the Berean Standard Bible separately). Every story and word problem is checked by our code before you see it, and the math answers are worked out by code, not by the AI.' },
  { q: 'Can I cancel anytime?', a: 'Yes. Cancel from your account page in a couple of clicks, with no phone call. You keep the program until the end of the period you paid for and you won\'t be charged again. Not happy in the first 14 days? Email us for a full refund.' },
  { q: 'I already have a Family, Classroom or founding plan. What changes?', a: 'Nothing you have goes away, and your price stays the same. Your plan now includes the full personalized program too, for up to 4 kids. Class lists and class packs keep working.' },
  { q: 'Does the free version stay free?', a: 'Yes. Every free tool, both free 36-week homeschool plans and their weekly packs keep working exactly as they do today. The paid program is the personalized layer on top.' },
  { q: 'How do I sign in on another device?', a: 'Go to Member sign in and enter the email you used at checkout plus the last 4 digits of the card you paid with. There\'s no password to remember. Kids\' names are saved per device, so you type them once on each one.' },
  { q: 'Who handles payment?', a: 'Square, the same payment company many local shops use. Your card details go straight to Square and never touch our servers.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={`Personalized Homeschool Program for Pre-K and K | ${SITE.name}`} description="A personalized homeschool program for ages 3 to 7: weekly printable packs themed on your child's interests, a new story starring them, and a plan that adjusts. Week 1 free." schema={faqSchema}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] items-start">
      <div class="prose-tl">
        <p class="text-[15px] font-bold text-muted mb-2!">Tracelings at Home, Personalized</p>
        <h1 class="text-[2.1rem] sm:text-[2.8rem] font-bold"><span class="ruled">A homeschool program built for one child</span></h1>
        <p class="mt-6">Their level, their pace, their interests. If your child loves dinosaurs, they count dinosaurs, read a short story about a dinosaur, and solve dinosaur word problems, while the plan still teaches the letters, word families, sight words and math for their level.</p>
        <p>It's a personalized Pre-K and kindergarten homeschool curriculum you print at home, about 10 to 30 minutes a day, for kids ages 3 to 7.</p>
        <div class="mt-6 grid grid-cols-2 gap-3">
          <div class="rounded-xl border border-rule bg-white p-4">
            <span class="block text-[13px] font-bold text-muted">Yearly</span>
            <span class="mt-1 block text-[1.7rem] leading-tight font-bold text-ink">$99<span class="text-[15px] font-normal text-muted">/year</span></span>
            <span class="mt-1 block text-[14px] leading-snug text-muted">$8.25/month billed yearly</span>
          </div>
          <div class="rounded-xl border border-hairline bg-white p-4">
            <span class="block text-[13px] font-bold text-muted">Monthly</span>
            <span class="mt-1 block text-[1.7rem] leading-tight font-bold text-ink">$14.99<span class="text-[15px] font-normal text-muted">/month</span></span>
            <span class="mt-1 block text-[14px] leading-snug text-muted">Cancel anytime</span>
          </div>
        </div>
        <p class="mt-4 text-[15px]">One price covers every kid in your family, up to 4.</p>
        <p class="rounded-xl bg-[#eef4ff] p-4 text-ink!"><strong>Week 1 is free.</strong> Take the <a href="/program/">5-minute placement check</a>, see your child's whole plan, and print their first week, themed and with their name. No card needed.</p>
      </div>
      <MembershipCheckout client:load />
    </div>

    <section class="mt-14" aria-labelledby="included">
      <h2 id="included" class="text-[1.6rem] font-bold">What's included every week</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        {included.map((i) => (
          <li class="rounded-xl border border-hairline bg-white p-5">
            <p class="font-bold text-ink">{i.t}</p>
            <p class="mt-1 text-[15px] text-muted leading-relaxed">{i.d}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="prose-tl max-w-[68ch] mt-14" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol>
        <li><strong>Placement check.</strong> Tell us your child's age, what they can do today, how many days a week you want to work, and up to 3 things they love. It takes about 5 minutes on the <a href="/program/">placement page</a>.</li>
        <li><strong>Their plan.</strong> You see the whole year as a timeline, starting at the right week for your child.</li>
        <li><strong>Print week 1 free.</strong> A plan page for you, then a page for each day.</li>
        <li><strong>Join to keep going.</strong> Each Monday the next week is ready, with a new story. Check in once a week and the plan adjusts.</li>
      </ol>
      <p class="rounded-xl border border-hairline bg-white p-4 text-ink!"><strong>Names stay on your device.</strong> We never send your child's name to the AI or to our servers. The story is written with a blank for the name, and your browser fills it in when it builds the PDF.</p>
      <p>Prefer to keep it simple? The free <a href="/homeschool/">Pre-K and kindergarten homeschool plans</a> stay free, with a printable weekly pack for every week.</p>
    </section>

    <section class="prose-tl max-w-[68ch] mt-14" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      <div class="divide-y divide-hairline border-y border-hairline">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none flex justify-between gap-4 font-bold text-[1.075rem] text-ink">{f.q}<span aria-hidden="true" class="text-muted group-open:rotate-45 transition-transform">+</span></summary>
            <p class="mt-3 mb-0!">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-6 text-[15px]">Questions about school or co-op use? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    </section>
  </div>
</Base>
