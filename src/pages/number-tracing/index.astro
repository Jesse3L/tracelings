---
import Base from '../../layouts/Base.astro';
import Tracer from '../../components/Tracer.tsx';
import { SITE } from '../../config';
import numbers from '../../data/numbers.json';

const title = `Free Number Tracing Worksheets 0 to 9 | ${SITE.name}`;
const description = 'Free printable number tracing worksheets for 0 to 9. Starting dots, three line sizes and blank rows for writing. Prints on Letter or A4.';
const url = new URL('/number-tracing/', SITE.url).href;
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Number tracing worksheets 0 to 9', url, description },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Number Tracing', item: url },
    ],
  },
];
---
<Base title={title} description={description} schema={schema}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <nav aria-label="Breadcrumb" class="pt-6 text-[14px] text-muted">
      <a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Number tracing</span>
    </nav>
    <header class="pt-6 pb-8 max-w-3xl">
      <h1 class="text-[2.1rem] sm:text-[2.8rem] font-bold"><span class="ruled">Free number tracing worksheets, 0 to 9</span></h1>
      <p class="mt-4 text-lg text-muted">Pick a number, choose a line size and print.</p>
    </header>

    <Tracer client:load mode="number" value="1" pick source="number-tracing" />

    <section class="mt-14" aria-labelledby="all-numbers">
      <h2 id="all-numbers" class="text-[1.6rem] font-bold">A page for every number</h2>
      <ul class="mt-6 grid grid-cols-5 sm:grid-cols-10 gap-2 max-w-3xl">
        {numbers.map((n) => (
          <li><a href={`/number-tracing/${n.digit}/`} class="block rounded-lg border border-hairline bg-white py-3 text-center text-2xl font-bold hover:border-rule">{n.digit}<span class="sr-only"> tracing worksheet</span></a></li>
        ))}
      </ul>
    </section>

    <article class="prose-tl max-w-[68ch] mt-12">
      <p class="text-[1.15rem]!">
        These number tracing worksheets are free for home and classroom use. Each sheet shows a solid example, rows of dotted numbers with
        green starting dots, and blank lines for writing without help.
      </p>
      <h2>Tips for teaching numbers</h2>
      <ul>
        <li><strong>Count first, then write.</strong> Have your child count real objects, then trace the number that matches.</li>
        <li><strong>Watch for reversals.</strong> Backward 3, 7 and 9 are normal at this age. Starting at the green dot every time helps.</li>
        <li><strong>Keep it short.</strong> One number a day for a week beats the whole set in one sitting.</li>
      </ul>
      <p>Ready for letters? Try our <a href="/letter-tracing/">letter tracing worksheets</a> or make a <a href="/name-tracing/">name tracing worksheet</a>.</p>
    </article>
  </div>
</Base>
