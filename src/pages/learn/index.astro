---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../config';
const all = (await getCollection('articles')).sort((a, b) => +b.data.published - +a.data.published);
---
<Base title={`Handwriting Help for Parents and Teachers | ${SITE.name}`} description="Practical guides on teaching kids to write their name, letters and numbers, with free printable practice sheets.">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-10">
    <h1 class="text-[2.1rem] sm:text-[2.8rem] font-bold"><span class="ruled">Handwriting help</span></h1>
    <p class="mt-4 text-lg text-muted max-w-2xl">Short, practical guides for parents, teachers and homeschool families.</p>
    <ul class="mt-10 max-w-3xl border-t border-hairline">
      {all.map((a) => (
        <li class="border-b border-hairline py-6">
          <a href={`/learn/${a.id}/`} class="text-xl font-bold text-ink underline decoration-rule decoration-2 underline-offset-4 hover:decoration-mid">{a.data.title}</a>
          <p class="mt-2 text-muted leading-relaxed">{a.data.description}</p>
          <p class="mt-1 text-[14px] text-muted">{a.data.readingMinutes} min read</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
