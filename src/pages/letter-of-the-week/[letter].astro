---
import Preview from '../../components/site/Preview.astro';
import Base from '../../layouts/Base.astro';
import WeekPack from '../../components/WeekPack.tsx';
import { SITE } from '../../config';
import letters from '../../data/letters.json';
import { LETTER_ORDER, preKWeekForLetter, dayPlan } from '../../lib/homeschool';

export function getStaticPaths() {
  return letters.map((l) => ({ params: { letter: l.letter }, props: { letter: l.letter } }));
}
const { letter } = Astro.props as { letter: string };
const L = letters.find((x) => x.letter === letter)!;
const U = letter.toUpperCase();
const week = preKWeekForLetter(letter);
const days = dayPlan('pre-k', week);
const at = LETTER_ORDER.indexOf(letter);
const prev = LETTER_ORDER[(at + 25) % 26];
const next = LETTER_ORDER[(at + 1) % 26];
const url = new URL(`/letter-of-the-week/${letter}/`, SITE.url).href;
const title = `Letter ${U} of the Week: Activities and Printables | ${SITE.name}`;
const description = `A letter ${U} of the week plan for preschool: how to write ${U} and ${letter}, ${L.words.slice(0, 2).join(' and ')} words, daily activities, and free letter ${U} tracing and bubble letter pages.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: `Letter ${U} of the week printable pack`,
    url,
    learningResourceType: 'Worksheet',
    educationalLevel: 'Preschool, Kindergarten',
    teaches: `Recognizing, writing and saying the sound of ${U} and ${letter}`,
    isAccessibleForFree: false,
    inLanguage: 'en-US',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Letter of the Week', item: SITE.url + '/letter-of-the-week/' },
      { '@type': 'ListItem', position: 3, name: `Letter ${U}`, item: url },
    ],
  },
];
---
<Base title={title} description={description} schema={schema}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <nav aria-label="Breadcrumb" class="pt-6 text-[14px] text-muted">
      <a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span> <a href="/letter-of-the-week/" class="hover:text-ink">Letter of the week</a> <span aria-hidden="true">/</span> <span aria-current="page">Letter {U}</span>
    </nav>
    <header class="pt-6 pb-8 max-w-3xl">
      <h1 class="text-[2.1rem] sm:text-[2.8rem] font-bold"><span class="ruled">Letter {U} of the week</span></h1>
      <p class="mt-4 text-lg text-muted">Five short days of {U} {letter} activities, plus free one-page {U} printables to start today.</p>
    </header>

    <section class="max-w-4xl rounded-2xl border border-hairline bg-white p-5 sm:p-6" aria-labelledby="free-h">
      <h2 id="free-h" class="text-[1.4rem] font-bold">Free letter {U} printables</h2>
      <p class="mt-1 text-muted">One page at a time, free for everyone, with your child's name where it fits.</p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
        <li><a id="free-tracing" href={`/letter-tracing/${letter}/`} class="block h-full rounded-lg border border-hairline px-4 py-3 hover:border-rule"><span class="block font-bold text-ink">Letter {U} tracing</span><span class="block text-[14px] text-muted">Capital and lowercase rows</span></a></li>
        <li><a href={`/bubble-letters/${letter}/`} class="block h-full rounded-lg border border-hairline px-4 py-3 hover:border-rule"><span class="block font-bold text-ink">Bubble letter {U}</span><span class="block text-[14px] text-muted">A big {U} to color</span></a></li>
        <li><a href={`/math-worksheets/pre-k/?number=${week.number}`} class="block h-full rounded-lg border border-hairline px-4 py-3 hover:border-rule"><span class="block font-bold text-ink">Count and color {week.number}</span><span class="block text-[14px] text-muted">This week's number</span></a></li>
        <li><a href="/name-tracing/" class="block h-full rounded-lg border border-hairline px-4 py-3 hover:border-rule"><span class="block font-bold text-ink">Name tracing</span><span class="block text-[14px] text-muted">Spot the {U} in their name</span></a></li>
      </ul>
    </section>

    <section id="pack" class="mt-12 scroll-mt-24" aria-labelledby="pack-h">
      <h2 id="pack-h" class="text-[1.4rem] font-bold">The full letter {U} week pack</h2>
      <p class="mt-1 mb-6 max-w-2xl text-muted">A plan page and a page for every day, in one PDF with your child's name. The weekly packs are part of Tracelings at Home. Week 1 of the plan, the name week, is free to try.</p>
      <WeekPack client:load level="pre-k" week={week.n} fixedLevel source="letter-of-the-week" />
    </section>
    <Preview k={`lotw-${letter}`} caption={`Example: the letter ${U} hunt page from this week's pack.`} />

    <article class="prose-tl max-w-[68ch] mt-14">
      <p class="text-[1.15rem]!">
        A letter {U} of the week gives your preschooler one short activity a day: tracing capital {U} and lowercase {letter}, a letter
        hunt, a bubble {U} to color, a counting page and their own name to trace. You can build the week from the free one-page
        printables above, or print the whole pack at once as a member. It's week {week.n} of
        our <a href="/homeschool/preschool/">homeschool preschool curriculum</a>.
      </p>

      <h2>Letter {U} week at a glance</h2>
      <ul>{days.map((d) => <li><strong>{d.day}, {d.title.toLowerCase()}:</strong> {d.how}</li>)}</ul>

      <h2>Words that start with {U}</h2>
      <p>Say these while your child colors or traces, and ask them to find one more around the house.</p>
      <ul class="columns-2 sm:columns-3">{L.words.map((w) => <li>{w}</li>)}</ul>

      <h2>How to write {U} and {letter}</h2>
      <p><strong>Capital {U}:</strong></p>
      <ol>{L.upperSteps.map((s) => <li>{s}</li>)}</ol>
      <p><strong>Lowercase {letter}:</strong></p>
      <ol>{L.lowerSteps.map((s) => <li>{s}</li>)}</ol>
      <p>{L.tip}</p>

      <h2>More letter {U} activities</h2>
      <ul>
        <li>Need more tracing? Print a <a href={`/letter-tracing/${letter}/`}>letter {U} tracing worksheet</a> with bigger or smaller lines.</li>
        <li>Color a <a href={`/bubble-letters/${letter}/`}>bubble letter {U}</a> on its own, or cut it out for a letter wall.</li>
        <li>Make a sensory bin with things that start with {U}, like {L.words.slice(0, 3).join(', ')} (toys or pictures work fine).</li>
        <li>Thursday's number this week is {week.number}. Want more counting? Make a <a href={`/math-worksheets/pre-k/?number=${week.number}`}>count and color page for {week.number}</a> or try the other <a href="/math-worksheets/pre-k/">pre-K math worksheets</a>.</li>
        <li>Read a picture book and stop each time you see a {U} or {letter}. Let your child keep count on their fingers.</li>
      </ul>
    </article>

    <nav aria-label="Other letters" class="mt-12">
      <div class="flex justify-between gap-4 max-w-[68ch] text-[1.05rem]">
        <a class="text-[#2f5fc4] underline underline-offset-4" href={`/letter-of-the-week/${prev}/`}>Previous in the plan: {prev.toUpperCase()}</a>
        <a class="text-[#2f5fc4] underline underline-offset-4" href={`/letter-of-the-week/${next}/`}>Next in the plan: {next.toUpperCase()}</a>
      </div>
      <ul class="mt-6 grid grid-cols-7 sm:grid-cols-13 gap-2 max-w-3xl">
        {letters.map((l) => (
          <li>
            <a href={`/letter-of-the-week/${l.letter}/`} aria-current={l.letter === letter ? 'page' : undefined}
              class={`block text-center rounded-md border py-2 font-bold ${l.letter === letter ? 'border-rule bg-white text-ink' : 'border-hairline text-muted hover:text-ink hover:bg-white'}`}>{l.letter.toUpperCase()}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</Base>
