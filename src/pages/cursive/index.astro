---
import Base from '../../layouts/Base.astro';
import FontTool from '../../components/FontTool.tsx';
import { SITE } from '../../config';

const title = `Free Cursive Worksheets: Name & Word Generator | ${SITE.name}`;
const description = 'Make free cursive worksheets from any name, word or sentence. Connected cursive on guide lines to trace, then write. For kids and adults. Free PDF.';
const url = new URL('/cursive/', SITE.url).href;
const faqs = [
  { q: 'What style of cursive does this use?', a: 'A traditional looped cursive close to what most US schools teach, with connected letters. It comes from an open-licensed school handwriting font designed for teaching.' },
  { q: 'What age should kids start cursive?', a: 'Many schools introduce cursive somewhere between second and third grade, around ages 7 to 9, once print handwriting feels comfortable. Some families start earlier at home. Your child’s teacher can tell you what their school uses.' },
  { q: 'Can I make a cursive name worksheet?', a: 'Yes. Type your child’s name and the sheet shows it in connected cursive, with a solid example on the first row and gray letters to trace below.' },
  { q: 'Is the name I type stored?', a: 'No. The worksheet is built in your browser and the text never leaves your device.' },
  { q: 'Is cursive still taught in schools?', a: 'It depends on the state and the school. Many schools cut back on cursive after the Common Core standards left it out, but several US states have since passed laws bringing cursive instruction back. If you want to know what your child will learn, ask their teacher or check your school district’s handwriting curriculum.' },
  { q: 'How do I write my name in cursive?', a: 'Type your name in the box above and the sheet shows it in connected cursive. Trace the gray letters slowly without lifting your pencil inside the word, then write it on the blank lines. Most people get comfortable after a week or two of short daily practice.' },
  { q: 'Can adults use these cursive worksheets?', a: 'Yes. The same tool works for adults who want to learn cursive, relearn it, or improve a signature. Choose the small line size for writing closer to everyday size, and type a sentence or quote instead of a single word.' },
  { q: 'What’s the difference between D’Nealian and Zaner-Bloser cursive?', a: 'Both are common US handwriting programs taught in schools. They differ in small ways, such as the shape of a few capitals and how some letters begin and join. Our sheets use a traditional US school cursive that is close to what most schools teach, so it works well alongside either program. If your child’s class uses one style strictly, a few letters may look slightly different.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Cursive Worksheet Generator', url, applicationCategory: 'EducationalApplication', operatingSystem: 'Any (web browser)', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Cursive Worksheets', item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={title} description={description} schema={schema}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <nav aria-label="Breadcrumb" class="pt-6 text-[14px] text-muted">
      <a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Cursive worksheets</span>
    </nav>
    <header class="pt-6 pb-8 max-w-3xl">
      <h1 class="text-[2.1rem] sm:text-[2.8rem] font-bold"><span class="ruled">Free cursive worksheet generator</span></h1>
      <p class="mt-4 text-lg text-muted">Type a name, word or short sentence and get connected cursive to trace and copy.</p>
    </header>

    <FontTool client:load kind="cursive" source="cursive" />

    <article class="prose-tl max-w-[68ch] mt-12">
      <p class="text-[1.15rem]!">
        This free cursive worksheet generator turns any name, word or sentence into connected cursive on handwriting lines. The first row
        shows a solid example, the gray rows are for tracing, and the blank rows at the bottom are for writing without help.
      </p>
      <h2>How to use these cursive worksheets</h2>
      <ol>
        <li><strong>Start with their name.</strong> A cursive name is the word most kids want to learn first, and it covers several letter joins at once.</li>
        <li><strong>Trace slowly, without lifting.</strong> Cursive is about the flow from one letter into the next. Tracing the gray letters in one smooth motion builds that habit.</li>
        <li><strong>Move to short words.</strong> Try family names, pets or spelling words once the name feels easy.</li>
      </ol>
      <h2>Cursive handwriting practice sheets for older kids and adults</h2>
      <p>
        Cursive isn't only for second graders. Older kids use these cursive handwriting practice sheets to tidy up their joins, and adults
        use them to relearn cursive they haven't used since school, to practice a signature, or simply because writing by hand feels good.
        Type a favorite quote or a short sentence, choose the small line size, and print a few pages. Start slowly and focus on even slant
        and spacing before speed.
      </p>
      <h2>Tips for learning cursive</h2>
      <ul>
        <li><strong>Learn letters in families.</strong> Letters that start the same way, like a, c, d, g and o, are easier to learn together.</li>
        <li><strong>Watch the joins.</strong> Most mistakes happen between letters, not in them. Point out where one letter hands off to the next.</li>
        <li><strong>Keep the paper tilted.</strong> A slight slant toward the writing hand makes cursive feel more natural.</li>
      </ul>
      <p>Just want a name? Make a <a href="/cursive-name-tracing/">cursive name tracing worksheet</a>. Want every letter? Print the <a href="/cursive-alphabet/">cursive alphabet worksheets</a>. Still working on print? Try <a href="/name-tracing/">name tracing</a> or <a href="/letter-tracing/">letter tracing</a>.</p>
      <h2>Frequently asked questions</h2>
      <div class="divide-y divide-hairline border-y border-hairline">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none flex justify-between gap-4 font-bold text-[1.075rem] text-ink">{f.q}<span aria-hidden="true" class="text-muted group-open:rotate-45 transition-transform">+</span></summary>
            <p class="mt-3 mb-0!">{f.a}</p>
          </details>
        ))}
      </div>
    </article>
  </div>
</Base>
